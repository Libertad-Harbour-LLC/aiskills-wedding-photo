# Required: your personal AI SKILLS API key (create one at https://aiskills.team/api-keys).
# Server-side only — never put it into NEXT_PUBLIC_* variables.
AISKILLS_API_KEY=ask_...

# Optional: API base URL (default https://aiskills.team/v1).
# AISKILLS_API_BASE=https://aiskills.team/v1

# Optional: if set, visitors must enter this code before they can start paid generations.
# ACCESS_CODE=

# Optional: set automatically when you connect a Vercel Blob store (Storage → Blob).
# Enables "upload from device"; without it visitors paste a public file link.
# BLOB_READ_WRITE_TOKEN=
